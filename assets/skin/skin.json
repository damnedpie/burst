		listStyle: default
	}
}
SliderStyle: {
	default-horizontal: {
		parent: default-horizontal
	}
	default-vertical: {
		parent: default-vertical
	}
}
TextButtonStyle: {
	default: {
		parent: default
		font: font_default
		fontColor: white
		downFontColor: pressed
		overFontColor: hover
		focusedFontColor: white
		disabledFontColor: disabled
	}
	default_flat: {
		parent: default_flat
		font: font_default
		fontColor: white
		downFontColor: pressed
		overFontColor: hover
		focusedFontColor: white
		disabledFontColor: disabled
	}
	default_flat_toggleable: {
		parent: default_flat
		font: font_default
		fontColor: white
		downFontColor: pressed
		overFontColor: hover
		focusedFontColor: white
		disabledFontColor: disabled
		checked: button_flat_default_pressed
	}
}
TextFieldStyle: {
	default: {
		font: font_default
		fontColor: white
		disabledFontColor: disabled
		background: panel_thin_default
		cursor: text_selection_pixel
		selection: text_selection_pixel
		messageFontColor: hover
	}
}
TextTooltipStyle: {
	default: {
		label: default
	}
}
TreeStyle: {
	default: {
		plus: tree_plus
		minus: tree_minus
	}
}
WindowStyle: {
	default: {
		titleFont: font_header
	}
}
