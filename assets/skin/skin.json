{
BitmapFont: {
	font_default: {
		file: font.fnt
		scaledSize: -1
		markupEnabled: true
		flip: false
	}
	font_header: {
		file: font_header.fnt
		scaledSize: -1
		markupEnabled: false
		flip: false
	}
}
Color: {
	accent_default: {
		hex: ffb800ff
	}
	accent_default_disabled: {
		hex: b27100ff
	}
	accent_default_hover: {
		hex: e5a400ff
	}
	accent_default_pressed: {
		hex: c98200ff
	}
	accent_green: {
		hex: 00ff00ff
	}
	disabled: {
		hex: a5a5a5ff
	}
	empty: {
		hex: ffffff00
	}
	hover: {
		hex: e5e5e5ff
	}
	pressed: {
		hex: ccccccff
	}
	white: {
		hex: ffffffff
	}
}
TintedDrawable: {
	button_default: {
		name: panel_thin
		color: accent_default
	}
	button_default_hover: {
		name: panel_thin
		color: accent_default_hover
	}
	button_default_pressed: {
		name: panel_thin
		color: accent_default_pressed
	}
	button_default_disabled: {
		name: panel_thin
		color: accent_default_disabled
	}
	top_bar_default: {
		name: top_bar
		color: accent_default
	}
	button_flat_default: {
		name: button_flat
		color: accent_default
	}
	button_flat_default_hover: {
		name: button_flat
		color: accent_default_hover
	}
	button_flat_default_pressed: {
		name: button_flat
		color: accent_default_pressed
	}
	button_flat_default_disabled: {
		name: button_flat
		color: accent_default_disabled
	}
	panel_default_default: {
		name: panel_default
		color: accent_default
	}
	panel_thin_default: {
		name: panel_thin
		color: accent_default
	}
	pbar_bg_default: {
		name: pbar_bg
		color: accent_default
	}
	button_checked_green: {
		name: button_checked
		color: accent_green
	}
	text_selection_pixel: {
		name: white-pixel
		color: accent_default
	}
	empty_pixel: {
		name: white-pixel
		color: empty
	}
}
TiledDrawable: {
	checker_bg_tiled: {
		region: checker_bg
		color: white
		minWidth: 16
		minHeight: 16
	}
}
ButtonStyle: {
	default: {
		up: button_default
		down: button_default_pressed
		over: button_default_hover
		disabled: button_default_disabled
	}
	default_flat: {
		up: button_flat_default
		down: button_flat_default_pressed
		over: button_flat_default_hover
		disabled: button_flat_default_disabled
	}
	color_pick: {
		up: button_checked
		down: button_checked
		over: button_checked
		disabled: button_checked
	}
}
CheckBoxStyle: {
	default: {
		parent: default_flat
		checkboxOn: checkbox_on
		checkboxOff: checkbox_off
		checkboxOnOver: checkbox_on_hover
		checkboxOver: checkbox_off_hover
		checkboxOnDisabled: checkbox_on_disabled
		checkboxOffDisabled: checkbox_off_disabled
		font: font_default
	}
}
ImageButtonStyle: {
	default: {
		parent: default
	}
	increase: {
		parent: default
		imageUp: increase
	}
	decrease: {
		parent: default
		imageUp: decrease
	}
	radio: {
		parent: default
		checked: button_checked_green
	}
}
ImageTextButtonStyle: {
	default: {
		parent: default
		font: font_default
	}
}
LabelStyle: {
	default: {
		font: font_default
		fontColor: white
	}
	header: {
		font: font_header
		fontColor: white
	}
}
ListStyle: {
	default: {
		font: font_default
		fontColorSelected: white
		fontColorUnselected: pressed
		selection: panel_thin_default
	}
}
ProgressBarStyle: {
	default-horizontal: {
		background: pbar_bg_default
		knobBefore: pbar_h_knob
	}
	default-vertical: {
		background: pbar_bg_default
		knobBefore: pbar_v_knob
	}
}
ScrollPaneStyle: {
	default: {
		background: panel_thin_default
		vScroll: panel_thin_default
		vScrollKnob: pbar_v_knob
	}
}
SelectBoxStyle: {
	default: {
		font: font_default
		fontColor: white
		background: button_flat_default
